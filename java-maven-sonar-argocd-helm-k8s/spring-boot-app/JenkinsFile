pipeline {

    agent {
        docker {
            image 'affan2310/maven-docker-agent:v1'
            registryUrl 'https://index.docker.io/v1/'
            registryCredentialsId 'docker-cred'
            args "--user root --entrypoint='' -v /var/run/docker.sock:/var/run/docker.sock"
            reuseNode true
        }
    }

    environment {
        APP_DIR         = 'java-maven-sonar-argocd-helm-k8s/spring-boot-app'
        DEPLOYMENT_FILE = 'java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml'

        // SonarQube - prefer the EC2 PRIVATE IP (run `hostname -I` on the EC2)
        SONAR_URL = 'http://13.203.76.118:9000'

        DOCKERHUB_USER = 'affan2310'
        DOCKER_IMAGE   = "${DOCKERHUB_USER}/ultimate-cicd:${BUILD_NUMBER}"

        GIT_REPO_NAME = 'Jenkins-Zero-To-Hero'
        GIT_USER_NAME = 'Affan2310'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main']],
                    userRemoteConfigs: [[url: "https://github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git"]]
                ])
                sh '''
                    git config --global --add safe.directory '*'
                    git rev-parse --short HEAD
                    java -version
                    mvn -v
                '''
            }
        }

        stage('Build and Test') {
            steps {
                sh '''
                    set -e
                    cd ${APP_DIR}
                    mvn clean package
                '''
            }
        }

        stage('Static Code Analysis') {
            steps {
                withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) {
                    sh '''
                        set -e
                        cd ${APP_DIR}
                        if command -v curl >/dev/null 2>&1; then
                            curl -s --max-time 10 ${SONAR_URL}/api/system/status || echo "WARN: SonarQube not reachable via curl"
                        fi
                        echo ""
                        mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                          -Dsonar.host.url=${SONAR_URL} \
                          -Dsonar.token=${SONAR_AUTH_TOKEN}
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    set -e
                    cd ${APP_DIR}
                    docker build -t ${DOCKER_IMAGE} .
                    docker inspect ${DOCKER_IMAGE} > /dev/null
                '''
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'docker-cred') {
                        docker.image("${DOCKER_IMAGE}").push()
                    }
                }
            }
        }

        stage('Update Deployment File') {
            steps {
                withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
                    sh '''
                        set -e
                        git config --global --add safe.directory '*'
                        git config user.email "affan2310@users.noreply.github.com"
                        git config user.name  "Affan2310"

                        REPO_URL="https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git"

                        git fetch "${REPO_URL}" main
                        git checkout -B main FETCH_HEAD

                        echo "Before:"; grep -n "image:" "${DEPLOYMENT_FILE}"
                        sed -i -E "s|(image:[[:space:]]*).*ultimate-cicd:.*|\\1${DOCKER_IMAGE}|" "${DEPLOYMENT_FILE}"
                        echo "After:";  grep -n "image:" "${DEPLOYMENT_FILE}"

                        git add "${DEPLOYMENT_FILE}"
                        if git diff --cached --quiet; then
                            echo "No changes to commit."
                        else
                            git commit -m "Update deployment image to ${BUILD_NUMBER} [skip ci]"
                            git push "${REPO_URL}" main
                        fi
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                if (env.WORKSPACE) {
                    sh 'chown -R $(stat -c "%u:%g" .) . || true'
                }
            }
            echo "Pipeline finished: ${currentBuild.currentResult}"
        }
        success {
            echo "Image ${DOCKER_IMAGE} pushed and GitOps manifest updated. Argo CD will sync it."
        }
    }
}
