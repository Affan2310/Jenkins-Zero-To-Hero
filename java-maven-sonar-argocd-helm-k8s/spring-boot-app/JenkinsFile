pipeline {

    agent {
        docker {
            image 'abhishekf5/maven-abhishek-docker-agent:v1'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
            reuseNode true
        }
    }

    environment {
        // Application
        APP_DIR = 'java-maven-sonar-argocd-helm-k8s/spring-boot-app'

        // SonarQube
        SONAR_URL = 'http://13.203.76.118:9000'

        // Docker
        DOCKER_IMAGE = "abhishekf5/ultimate-cicd:${BUILD_NUMBER}"

        // GitHub
        GIT_REPO_NAME = 'Jenkins-Zero-To-Hero'
        GIT_USER_NAME = 'Affan2310'
    }

    stages {

        // =========================================================
        // 1. CHECKOUT
        // =========================================================
        stage('Checkout') {
            steps {
                echo "Checking out application source code..."

                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main']],
                    userRemoteConfigs: [[
                        url: 'https://github.com/Affan2310/Jenkins-Zero-To-Hero.git'
                    ]]
                ])

                sh '''
                    echo "Current commit:"
                    git rev-parse --short HEAD

                    echo "Repository contents:"
                    ls -ltr

                    echo "Application directory:"
                    ls -ltr ${APP_DIR}
                '''
            }
        }


        // =========================================================
        // 2. BUILD + UNIT TEST
        // =========================================================
        stage('Build and Test') {
            steps {
                sh '''
                    set -e

                    cd ${APP_DIR}

                    echo "Cleaning previous Maven build..."
                    mvn clean

                    echo "Building application and running tests..."
                    mvn package

                    echo "Build completed successfully."
                '''
            }
        }


        // =========================================================
        // 3. SONARQUBE STATIC CODE ANALYSIS
        // =========================================================
        stage('Static Code Analysis') {
            steps {

                withCredentials([
                    string(
                        credentialsId: 'sonarqube',
                        variable: 'SONAR_AUTH_TOKEN'
                    )
                ]) {

                    sh '''
                        set -e

                        cd ${APP_DIR}

                        echo "Checking SonarQube connectivity..."

                        curl -f ${SONAR_URL}/api/system/status

                        echo ""
                        echo "Running SonarQube analysis..."

                        mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                          -Dsonar.host.url=${SONAR_URL} \
                          -Dsonar.token=${SONAR_AUTH_TOKEN}

                        echo ""
                        echo "SonarQube analysis completed successfully."
                    '''
                }
            }
        }


        // =========================================================
        // 4. DOCKER BUILD
        // =========================================================
        stage('Build Docker Image') {
            steps {

                sh '''
                    set -e

                    cd ${APP_DIR}

                    echo "Building Docker image:"
                    echo "${DOCKER_IMAGE}"

                    docker build \
                        -t ${DOCKER_IMAGE} \
                        .

                    echo ""
                    echo "Docker image created successfully."

                    docker images | grep ultimate-cicd
                '''
            }
        }


        // =========================================================
        // 5. DOCKER IMAGE CHECK
        // =========================================================
        stage('Docker Image Test') {
            steps {

                sh '''
                    set -e

                    echo "Inspecting Docker image..."

                    docker inspect ${DOCKER_IMAGE} > /dev/null

                    echo "Docker image inspection successful."
                '''
            }
        }


        // =========================================================
        // 6. PUSH IMAGE TO DOCKER HUB
        // =========================================================
        stage('Push Docker Image') {
            steps {

                script {

                    echo "Pushing image: ${DOCKER_IMAGE}"

                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'docker-cred'
                    ) {

                        def dockerImage = docker.image("${DOCKER_IMAGE}")

                        dockerImage.push()

                        echo "Docker image pushed successfully."
                    }
                }
            }
        }


        // =========================================================
        // 7. UPDATE GITOPS DEPLOYMENT
        // =========================================================
        stage('Update Deployment File') {
            steps {

                withCredentials([
                    string(
                        credentialsId: 'github',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "Updating Kubernetes deployment image tag..."

                        git config user.email "affan2310@users.noreply.github.com"
                        git config user.name "Affan2310"

                        DEPLOYMENT_FILE="${APP_DIR}-manifests/deployment.yml"

                        echo "Deployment file:"
                        echo "${DEPLOYMENT_FILE}"

                        echo ""
                        echo "Before update:"
                        grep -n "image:" "${DEPLOYMENT_FILE}" || true

                        sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" "${DEPLOYMENT_FILE}"

                        echo ""
                        echo "After update:"
                        grep -n "image:" "${DEPLOYMENT_FILE}" || true

                        git add "${DEPLOYMENT_FILE}"

                        git commit \
                            -m "Update deployment image to version ${BUILD_NUMBER}" \
                            || echo "No changes to commit."

                        git push \
                            https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git \
                            HEAD:main

                        echo ""
                        echo "GitOps repository updated successfully."
                    '''
                }
            }
        }
    }


    // =============================================================
    // POST ACTIONS
    // =============================================================
    post {

        success {
            echo '''
            ==========================================
            Jenkins Pipeline Completed Successfully
            ==========================================
            Application Build       : SUCCESS
            Unit Tests              : SUCCESS
            SonarQube Analysis      : SUCCESS
            Docker Build            : SUCCESS
            Docker Push             : SUCCESS
            GitOps Update           : SUCCESS

            Argo CD should now detect the
            GitOps repository change and
            synchronize the Kubernetes deployment.
            ==========================================
            '''
        }

        failure {
            echo '''
            ==========================================
            Jenkins Pipeline FAILED
            ==========================================
            Check the failed stage above.
            ==========================================
            '''
        }

        always {
            echo "Pipeline finished: ${currentBuild.currentResult}"
        }
    }
}
